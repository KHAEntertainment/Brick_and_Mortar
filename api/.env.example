# ============================================
# BRICK & MORTAR API - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and configure for your environment
# For Docker server deployment, set these in Portainer environment variables

# ===================
# APPLICATION CONFIG
# ===================

# Environment: development, staging, production
ENVIRONMENT=development

# ===================
# PORT CONFIGURATION
# ===================

# Brick & Mortar API specific port (takes precedence over generic PORT)
BRICK_MORTAR_PORT=9000

# Generic port variable (fallback for compatibility)
PORT=9000

# Common alternative ports if 9000 is taken:
# BRICK_MORTAR_PORT=8080  # Alternative web port
# BRICK_MORTAR_PORT=3000  # Node.js default
# BRICK_MORTAR_PORT=8888  # Jupyter/common dev port
# BRICK_MORTAR_PORT=9001  # Next sequential port
# BRICK_MORTAR_PORT=18090 # Production server allocation

# Note: The API will check port availability on startup and warn about conflicts

# Log level: debug, info, warning, error
LOG_LEVEL=info

# ===================
# SECURITY & CORS
# ===================

# CORS Origins (comma-separated list)
# Development: leave empty for "*" (allow all)
# Production: specify exact domains
CORS_ORIGINS=https://bm-api.khaent.com,https://app.khaent.com,http://bm-api.nas1

# ===================
# SUPABASE INTEGRATION (Future Use)
# ===================

# Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# Supabase service role key (for server-side operations)
# IMPORTANT: Use Docker secrets in production, not environment variables
SUPABASE_SERVICE_ROLE_KEY_FILE=/run/secrets/supabase_service_key

# ===================
# DOCKER SERVER CONFIG
# ===================

# Project path for development mounts
PROJECT_PATH=/volume1/homes/docker/development/projects

# Domain suffix for local access
DOMAIN_SUFFIX=nas1

# ===================
# DEVELOPMENT ONLY
# ===================

# Local development overrides
DEV_HOST=localhost
DEV_PORT=9000

# ===================
# PRODUCTION SECRETS
# ===================

# These should be managed via Docker secrets, not environment variables
# Listed here for documentation purposes only

# Basic auth file for Traefik (Docker secret: bm_api_auth)
# Format: username:hashed-password
# Generate with: htpasswd -nb username password

# Supabase service role key (Docker secret: supabase_service_key)
# Used for server-side Supabase operations

# ===================
# DOCKER COMPOSE VARS
# ===================

# Used in docker-compose.yml for port configuration
# Set these before running: docker-compose up

# BRICK_MORTAR_PORT=8080  # Use alternative port if 9000 conflicts
# ENVIRONMENT=development
# CORS_ORIGINS=*  # Development default (allow all origins)

# Production deployment in docker-compose.production.yml:
# BRICK_MORTAR_PORT=18090
# ENVIRONMENT=production
# CORS_ORIGINS=https://bm-api.khaent.com,https://app.khaent.com
# LOG_LEVEL=info
# PROJECT_PATH=/volume1/homes/docker/development/projects

# ===================
# HEALTH CHECK CONFIG
# ===================

# Health check endpoint: GET /api/health
# Returns service status, version, environment info
# Used by Docker health checks and Traefik

# ===================
# TRAEFIK INTEGRATION
# ===================

# Local access (no auth): http://bm-api.nas1
# Internet access (basic auth): https://bm-api.khaent.com
# Direct port access: http://server-ip:18090 (if needed)

# ===================
# NOTES
# ===================

# 1. For production deployment on Docker server:
#    - Use Portainer environment variables (not .env file)
#    - Create Docker secrets for sensitive data
#    - Follow server port allocation (18090)
#    - Connect to php-dev-stack_dev-network

# 2. For local development:
#    - Copy this file to .env
#    - Use development defaults (PORT 9000)
#    - If port conflicts occur, set BRICK_MORTAR_PORT to alternative
#    - API will detect port conflicts and suggest alternatives

# 3. For frontend integration:
#    - Update frontend API URLs to match deployment
#    - Use environment-specific configuration
#    - Test both local and internet access